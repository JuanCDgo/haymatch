{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "haymatch",
  "main": "worker/index.ts",
  "compatibility_date": "2025-04-01",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SALA_ROOM",
        "class_name": "SalaRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SalaRoom"]
    }
  ]
}
